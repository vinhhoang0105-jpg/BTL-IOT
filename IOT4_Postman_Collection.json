	"item": [
		{
			"name": "1. IOT4 (PHP Backend - localhost)",
			"item": [
				{
					"name": "1.1. Devices - Lấy trạng thái tất cả thiết bị",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Status code is 200\", function () {",
									"    pm.response.to.have.status(200);",
									"});",
									"",
									"pm.test(\"Response success is true\", function () {",
									"    var jsonData = pm.response.json();",
									"    pm.expect(jsonData.success).to.be.true;",
									"    pm.expect(jsonData.data).to.be.an('array');",
									"});",
									"",
									"pm.test(\"Mỗi thiết bị có id, name, status\", function () {",
									"    var jsonData = pm.response.json();",
									"    if (jsonData.data.length > 0) {",
									"        var firstDevice = jsonData.data[0];",
									"        pm.expect(firstDevice).to.have.property('id');",
									"        pm.expect(firstDevice).to.have.property('name');",
									"        pm.expect(firstDevice).to.have.property('status');",
									"    }",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Accept",
								"value": "application/json"
							}
						],
						"url": {
							"raw": "{{base_url_iot4}}/api/devices/status.php",
							"host": [
								"{{base_url_iot4}}"
							],
							"path": [
								"api",
								"devices",
								"status.php"
							]
						},
						"description": "Lấy danh sách và trạng thái hiện tại (on/off) của tất cả thiết bị."
					},
					"response": []
				},
				{
					"name": "1.2. Devices - Điều khiển BẬT thiết bị (TURN_ON)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Status code is 200\", function () {",
									"    pm.response.to.have.status(200);",
									"});",
									"",
									"pm.test(\"Response success is true and returns actionId\", function () {",
									"    var jsonData = pm.response.json();",
									"    pm.expect(jsonData.success).to.be.true;",
									"    pm.expect(jsonData).to.have.property('actionId');",
									"    pm.collectionVariables.set(\"last_action_id\", jsonData.actionId);",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"deviceId\": 1,\n    \"action\": \"TURN_ON\"\n}"
						},
						"url": {
							"raw": "{{base_url_iot4}}/api/devices/control.php",
